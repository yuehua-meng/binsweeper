<Window x:Class="BinSweeper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BinSweeper"
        Icon="Assets/BinSweeper.ico"
        Width="620"
        Height="680"
        MinWidth="540"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8FAFC" Offset="0" />
            <GradientStop Color="#EFF6F2" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="#E8EEF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.07"
                                      Color="#0F172A" />
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
            <Border x:Name="Root" Background="#059669" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#10B981" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#047857" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
            <Border x:Name="Root"
                    Background="#FFFFFF"
                    BorderBrush="#DDE5EC"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#F1F5F9" />
                    <Setter TargetName="Root" Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#E2E8F0" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="DangerButtonTemplate" TargetType="Button">
            <Border x:Name="Root" Background="#DC2626" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#EF4444" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#B91C1C" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource SecondaryButtonTemplate}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource DangerButtonTemplate}" />
        </Style>

        <ControlTemplate x:Key="DangerGhostButtonTemplate" TargetType="Button">
            <Border x:Name="Root"
                    Background="#FFF1F2"
                    BorderBrush="#FECDD3"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#FFE4E6" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#FECDD3" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DangerGhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource DangerGhostButtonTemplate}" />
        </Style>

        <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track"
                                    Width="40"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="#CBD5E1"
                                    VerticalAlignment="Center">
                                <Border x:Name="Thumb"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="#FFFFFF"
                                        HorizontalAlignment="Left"
                                        Margin="2,0,0,0" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#059669" />
                                <Setter TargetName="Thumb" Property="Margin" Value="20,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,22,24,22">
        <StackPanel>

            <!-- 标题 -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="14"
                            Background="#FFFFFF"
                            BorderBrush="#E8EEF3"
                            BorderThickness="1">
                        <Image Source="Assets/app-icon.png" Margin="7" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BinSweeper"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="回收站小文件自动清理 · 大文件只统计不动"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#ECFDF5"
                        CornerRadius="8"
                        Padding="10,6">
                    <TextBlock Text="本地运行 · 无需管理员"
                               FontSize="11"
                               Foreground="#047857" />
                </Border>
            </Grid>

            <!-- 主统计卡 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="可清理小文件" Style="{StaticResource CardLabel}" />
                        <TextBlock x:Name="EligibleText"
                                   Text="—"
                                   FontSize="44"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="EligibleDetailText"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#ECFDF5"
                            CornerRadius="8"
                            Padding="10,5">
                        <TextBlock Text="≤ 1 MiB"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#047857" />
                    </Border>
                </Grid>
            </Border>

            <!-- 大文件 / 待清理区 -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="大文件（不自动处理）" Style="{StaticResource CardLabel}" />
                        <TextBlock x:Name="LargeText"
                                   Text="—"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="待清理区" Style="{StaticResource CardLabel}" />
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock x:Name="StagingText"
                                       Text="—"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Margin="0,0,78,0"
                                       TextWrapping="Wrap" />
                            <Button x:Name="PurgeStagingButton"
                                    Content="永久清空"
                                    Style="{StaticResource DangerGhostButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="OnPurgeStagingClick"
                                    ToolTip="永久删除待清理区里的全部内容，无法恢复" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 操作 -->
            <WrapPanel Margin="0,18,0,0">
                <Button x:Name="ScanButton"
                        Content="扫描"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnScanClick" />
                <Button x:Name="StageButton"
                        Content="清理到 2,000"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnStageClick" />
                <Button x:Name="RestoreButton"
                        Content="恢复全部"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnRestoreClick" />
                <Button x:Name="OpenStagingButton"
                        Content="打开待清理区"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnOpenStagingClick" />
            </WrapPanel>

            <!-- 永久删除 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="16,12">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="永久删除"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#B91C1C" />
                        <TextBlock Text="删除全部 ≤1 MiB 小文件，不进入待清理区"
                                   FontSize="11.5"
                                   Foreground="#64748B"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="PurgeButton"
                            Content="直接全部删除"
                            Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnPurgeClick"
                            ToolTip="永久删除回收站里的可清理小文件（≤1 MiB），无法恢复；大文件、混合目录不动" />
                </Grid>
            </Border>

            <!-- 设置 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="16,8">
                <StackPanel>
                    <CheckBox x:Name="AutoCleanCheckBox"
                              Style="{StaticResource SwitchCheckBox}"
                              Content="后台自动清理（每 5 分钟检查，达到触发线才动手）"
                              Checked="OnAutoCleanChanged"
                              Unchecked="OnAutoCleanChanged" />
                    <CheckBox x:Name="AutoStartCheckBox"
                              Style="{StaticResource SwitchCheckBox}"
                              Content="开机自启"
                              Checked="OnAutoStartChanged"
                              Unchecked="OnAutoStartChanged" />
                </StackPanel>
            </Border>

            <!-- 状态 -->
            <Border Background="#F1F5F9"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,14,0,0">
                <TextBlock x:Name="StatusText"
                           Text="准备就绪"
                           Foreground="#475569"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
